# ========================================================
# RevForge AI — Environment Configuration Specification
# ========================================================

# Deployment Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Canonical Base URL of the Application
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection String (Supabase / Neon / Local Docker)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/revforge"

# Mock Sandbox Mode ('true' for local dev without Ghidra/gVisor; 'false' in production)
MOCK_SANDBOX="true"

# ========================================================
# Paddle Billing (Primary Payment Gateway)
# ========================================================
# API Key generated from Paddle Dashboard -> Developer Tools -> Authentication
PADDLE_API_KEY="pdl_api_..."

# Webhook Secret Key from Paddle Notifications Settings
PADDLE_WEBHOOK_SECRET_KEY="pdl_ntf_set_..."

# Paddle Environment ('sandbox' for testing, 'production' for live payments)
PADDLE_ENVIRONMENT="sandbox"

# ========================================================
# Stripe (Secondary Gateway / Optional)
# ========================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ========================================================
# Redis Cache, BullMQ Worker & Rate Limiting (Upstash / Local)
# ========================================================
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# ========================================================
# NextAuth / Session Security
# ========================================================
# 32+ character random secret for JWT signing and cookie encryption
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-min-length"
NEXTAUTH_URL="http://localhost:3000"

# ========================================================
# Cloudflare R2 / S3 Object Storage (Clean-Room Artifact Vault)
# ========================================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="revforge-artifacts"

# ========================================================
# Docker / gVisor Sandbox Host Settings
# ========================================================
DOCKER_RUNTIME="runsc"
SANDBOX_VAULT_PATH="/var/revforge/vault"
