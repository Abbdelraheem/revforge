# ========================================================
# RevForge — Environment Configuration
# ========================================================

# Deployment Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Canonical Base URL of the Application
APP_URL="http://localhost:3000"

# Application Database (NOBYPASSRLS app role)
DATABASE_URL="postgres://revforge_app:app_password@127.0.0.1:5432/revforge"

# System Database (BYPASSRLS system role — used only by webhooks, worker, outbox, admin)
SYSTEM_DATABASE_URL="postgres://revforge_system:system_password@127.0.0.1:5432/revforge"

# ========================================================
# LLM & Model Configuration
# ========================================================
ANTHROPIC_API_KEY="sk-ant-api03-..."
LLM_PROVIDER="anthropic" # 'anthropic' in production, 'fixture' only in non-production test/dev
LLM_MODEL_FAST="claude-3-5-haiku-latest"
LLM_MODEL_STANDARD="claude-3-5-sonnet-latest"
LLM_MODEL_PREMIUM="claude-3-7-sonnet-latest"

# ========================================================
# Payment Gateway (Paddle)
# ========================================================
PAYMENT_PROVIDER="paddle" # 'paddle' in production, 'fake' only in non-production test/dev
PADDLE_API_KEY="pdl_api_..."
PADDLE_WEBHOOK_SECRET_KEY="pdl_ntf_set_..."
PADDLE_ENVIRONMENT="sandbox" # 'sandbox' | 'production'
FAKE_WEBHOOK_SECRET="local-dev-fake-webhook-signing-secret"

# ========================================================
# Redis & BullMQ Worker Queue
# ========================================================
REDIS_URL="redis://127.0.0.1:6379"

# ========================================================
# S3-Compatible Object Storage (Artifacts & Deliveries)
# ========================================================
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET_UPLOADS="uploads"
STORAGE_BUCKET_EVIDENCE="evidence-raw"
STORAGE_BUCKET_SPECS="specs"
STORAGE_BUCKET_DELIVERIES="deliveries"

# ========================================================
# Email Service (Resend)
# ========================================================
RESEND_API_KEY="re_..."
EMAIL_FROM="RevForge <notifications@revforge.ai>"
SUPERADMIN_EMAIL="admin@revforge.ai"

# ========================================================
# Security, Sessions & Storage Tokens (min 32 characters)
# ========================================================
DATA_KEY="generate-32-char-random-secret-for-data-signing"
NEXTAUTH_SECRET="generate-32-char-random-secret-for-sessions"
AUTH_SECRET="generate-32-char-random-secret-for-auth"
NEXTAUTH_URL="http://localhost:3000"

# ========================================================
# Sandbox Runtime & Execution Limits
# ========================================================
SANDBOX_RUNTIME="runsc" # 'runsc' (gVisor) required in production, 'runc' only permitted in non-prod
BUILD_AGENT_CONCURRENCY=6
WORKER_IDLE_SHUTDOWN_MIN=30
COST_CAP_RATIO=0.6
MIN_BUILD_MARGIN_PCT=25
MARGIN_ALERT_PCT=20

# ========================================================
# Payment Processor Fees (Paddle defaults: 5% + 50 cents)
# ========================================================
PAYMENT_FEE_PERCENT=5
PAYMENT_FEE_FIXED_CENTS=50

# ========================================================
# Live Preview Worker
# ========================================================
PREVIEW_TUNNEL_SECRET="generate-32-char-random-secret-for-preview-tunnel"
PREVIEW_ORIGIN="http://localhost:4100"
PREVIEW_PORT_BASE=4100
PREVIEW_MAX_CONCURRENT=2
PREVIEW_IDLE_TTL_MIN=10
PREVIEW_HARD_TTL_MIN=60
PREVIEW_REQUEST_TIMEOUT_MS=15000
PREVIEW_MAX_RESPONSE_BYTES=5000000
WORKER_TUNNEL_URL="http://127.0.0.1:3001"

# ========================================================
# Studio Post-Delivery Editor Configuration
# ========================================================
STUDIO_TOKEN_CENTS=1
STUDIO_INCLUDED_RATIO=0.15
STUDIO_MARKUP=3.0
STUDIO_MIN_CHARGE_CENTS=50
STUDIO_DAILY_EDIT_LIMIT=20
